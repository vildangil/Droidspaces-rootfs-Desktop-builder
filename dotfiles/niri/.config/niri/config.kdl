// DroidSpaces Niri Touch - readable, roomy tablet UI.
// Requires the AnLand-patched niri compositor on Arch ARM64.
// Change the bindings in your personal config; this is only the shipped default.

input {
    keyboard {
        xkb {
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

hotkey-overlay { skip-at-startup; }

prefer-no-csd

layout {
    gaps 10
    default-column-width { proportion 0.92; }
    preset-column-widths {
        proportion 0.50
        proportion 0.75
        proportion 0.92
    }
    focus-ring {
        width 3
        active-color "#80B9FF"
        inactive-color "#343D55"
    }
    border { off; }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Top-left hot corner opens the overview; edge drag-and-drop is touch usable.
gestures {
    hot-corners {
        top-left
    }
    dnd-edge-view-scroll {
        trigger-width 72
        delay-ms 90
        max-speed 1800
    }
    dnd-edge-workspace-switch {
        trigger-height 68
        delay-ms 110
        max-speed 1500
    }
}

// Native touchscreen 3-finger workspace gestures are not assumed.
// Use the large touch controls in the bottom Waybar dock instead.
spawn-at-startup "waybar"
spawn-at-startup "swaybg" "-c" "#101827"
spawn-at-startup "mako"
spawn-at-startup "squeekboard"

binds {
    Mod+Return { spawn "foot"; }
    Mod+D { spawn "fuzzel"; }
    Mod+O { toggle-overview; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+Slash { show-hotkey-overlay; }
}
